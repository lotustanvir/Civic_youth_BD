generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  articles     Article[]
  @@map("users")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model Program {
  id          String   @id @default(uuid())
  slug        String   @unique
  titleEn     String   @map("title_en")
  titleBn     String   @map("title_bn")
  shortDescEn String   @map("short_desc_en")
  shortDescBn String   @map("short_desc_bn")
  fullDescEn  String?  @map("full_desc_en")
  fullDescBn  String?  @map("full_desc_bn")
  image       String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@index([published])
  @@index([sortOrder])
  @@map("programs")
}

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  nameEn    String   @map("name_en")
  nameBn    String   @map("name_bn")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  articles  Article[]
  @@map("categories")
}

model Article {
  id          String    @id @default(uuid())
  slug        String    @unique
  titleEn     String    @map("title_en")
  titleBn     String    @map("title_bn")
  excerptEn   String    @map("excerpt_en")
  excerptBn   String    @map("excerpt_bn")
  bodyEn      String?   @map("body_en")
  bodyBn      String?   @map("body_bn")
  categoryId  String    @map("category_id")
  image       String?
  authorId    String?   @map("author_id")
  readTime    String?   @map("read_time")
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  category    Category  @relation(fields: [categoryId], references: [id])
  author      User?     @relation(fields: [authorId], references: [id])
  @@index([published])
  @@index([categoryId])
  @@index([publishedAt])
  @@map("articles")
}

model ThematicArea {
  id             String   @id @default(uuid())
  slug           String   @unique
  titleEn        String   @map("title_en")
  titleBn        String   @map("title_bn")
  descEn         String   @map("desc_en")
  descBn         String   @map("desc_bn")
  fullDescEn     String?  @map("full_desc_en")
  fullDescBn     String?  @map("full_desc_bn")
  icon           String
  accentColor    String   @default("green") @map("accent_color")
  href           String
  primaryImage   String?  @map("primary_image")
  secondaryImage String?  @map("secondary_image")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@index([sortOrder])
  @@map("thematic_areas")
}

model Opportunity {
  id        String    @id @default(uuid())
  slug      String    @unique
  titleEn   String    @map("title_en")
  titleBn   String    @map("title_bn")
  typeEn    String    @map("type_en")
  typeBn    String    @map("type_bn")
  deadline  DateTime? @map("deadline")
  descEn    String    @map("desc_en")
  descBn    String    @map("desc_bn")
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  @@index([published])
  @@map("opportunities")
}

model Partner {
  id            String   @id @default(uuid())
  name          String
  logo          String?
  website       String?
  descriptionEn String?  @map("description_en")
  descriptionBn String?  @map("description_bn")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@index([sortOrder])
  @@map("partners")
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  roleEn    String   @map("role_en")
  roleBn    String   @map("role_bn")
  bioEn     String?  @map("bio_en")
  bioBn     String?  @map("bio_bn")
  image     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([sortOrder])
  @@map("team_members")
}

model ImpactMetric {
  id        String     @id @default(uuid())
  type      MetricType
  labelEn   String     @map("label_en")
  labelBn   String     @map("label_bn")
  value     Int
  suffix    String?
  published Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  @@index([type])
  @@index([published])
  @@map("impact_metrics")
}

enum MetricType {
  CURRENT
  TARGET
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  @@map("newsletter_subscribers")
}

enum MemberType {
  STUDENT
  PROFESSIONAL
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model MembershipApplication {
  id          String          @id @default(uuid())
  fullName    String          @map("full_name")
  email       String
  phone       String
  institution String
  department  String?
  memberType  MemberType      @map("member_type")
  district    String?
  interests   String?
  motivation  String
  consent     Boolean
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("membership_applications")
}

model VolunteerApplication {
  id            String          @id @default(uuid())
  fullName      String          @map("full_name")
  email         String
  phone         String
  institution   String?
  skills        String?
  interests     String?
  experience    String?
  availability  String?
  motivation    String
  portfolioUrl  String?         @map("portfolio_url")
  consent       Boolean
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("volunteer_applications")
}

model PartnershipInquiry {
  id                String          @id @default(uuid())
  organizationName  String          @map("organization_name")
  contactPerson     String          @map("contact_person")
  email             String
  phone             String?
  organizationType  String?         @map("organization_type")
  website           String?
  partnershipInterest String        @map("partnership_interest")
  message           String
  consent           Boolean
  status            ApplicationStatus @default(PENDING)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("partnership_inquiries")
}